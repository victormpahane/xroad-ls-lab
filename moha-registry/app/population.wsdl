<?xml version="1.0" encoding="UTF-8"?>
<!--
  MOHA Population Registry - SOAP service description for X-Road.

  The Security Server reads three things from this file:
    * each operation in the SOAP binding becomes a service code (verifyIdentity)
    * <xrd:version> on the operation becomes the service version (v1)
    * <soap:address location> becomes the service URL ss3 forwards to

  The X-Road header elements are declared inline (no external xsd import),
  so the Security Server never needs internet access to parse this WSDL.
-->
<wsdl:definitions name="populationRegistry"
    targetNamespace="http://moha.gov.ls/population"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:xrd="http://x-road.eu/xsd/xroad.xsd"
    xmlns:tns="http://moha.gov.ls/population">

  <wsdl:types>
    <xsd:schema targetNamespace="http://x-road.eu/xsd/xroad.xsd" elementFormDefault="qualified">
      <xsd:complexType name="IdentifierType">
        <xsd:sequence>
          <xsd:any namespace="##any" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
        <xsd:anyAttribute namespace="##any" processContents="lax"/>
      </xsd:complexType>
      <xsd:element name="client" type="xrd:IdentifierType"/>
      <xsd:element name="service" type="xrd:IdentifierType"/>
      <xsd:element name="id" type="xsd:string"/>
      <xsd:element name="userId" type="xsd:string"/>
      <xsd:element name="protocolVersion" type="xsd:string"/>
    </xsd:schema>

    <xsd:schema targetNamespace="http://moha.gov.ls/population" elementFormDefault="qualified">
      <xsd:element name="verifyIdentity">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="nationalId" type="xsd:string"/>
            <xsd:element name="firstName" type="xsd:string" minOccurs="0"/>
            <xsd:element name="surname" type="xsd:string" minOccurs="0"/>
            <xsd:element name="dateOfBirth" type="xsd:date" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="verifyIdentityResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="nationalId" type="xsd:string"/>
            <xsd:element name="found" type="xsd:boolean"/>
            <xsd:element name="match" type="xsd:boolean"/>
            <xsd:element name="mismatchedFields" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
            <xsd:element name="vitalStatus" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </wsdl:types>

  <wsdl:message name="requestheader">
    <wsdl:part name="client" element="xrd:client"/>
    <wsdl:part name="service" element="xrd:service"/>
    <wsdl:part name="id" element="xrd:id"/>
    <wsdl:part name="userId" element="xrd:userId"/>
    <wsdl:part name="protocolVersion" element="xrd:protocolVersion"/>
  </wsdl:message>
  <wsdl:message name="verifyIdentity">
    <wsdl:part name="body" element="tns:verifyIdentity"/>
  </wsdl:message>
  <wsdl:message name="verifyIdentityResponse">
    <wsdl:part name="body" element="tns:verifyIdentityResponse"/>
  </wsdl:message>

  <wsdl:portType name="populationRegistryPortType">
    <wsdl:operation name="verifyIdentity">
      <wsdl:documentation>Confirms that the supplied personal details match the population register, without returning the record itself.</wsdl:documentation>
      <wsdl:input message="tns:verifyIdentity"/>
      <wsdl:output message="tns:verifyIdentityResponse"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="populationRegistryBinding" type="tns:populationRegistryPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="verifyIdentity">
      <soap:operation soapAction="" style="document"/>
      <xrd:version>v1</xrd:version>
      <xrd:title xml:lang="en">Verify citizen identity</xrd:title>
      <wsdl:input>
        <soap:body parts="body" use="literal"/>
        <soap:header message="tns:requestheader" part="client" use="literal"/>
        <soap:header message="tns:requestheader" part="service" use="literal"/>
        <soap:header message="tns:requestheader" part="id" use="literal"/>
        <soap:header message="tns:requestheader" part="userId" use="literal"/>
        <soap:header message="tns:requestheader" part="protocolVersion" use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body parts="body" use="literal"/>
        <soap:header message="tns:requestheader" part="client" use="literal"/>
        <soap:header message="tns:requestheader" part="service" use="literal"/>
        <soap:header message="tns:requestheader" part="id" use="literal"/>
        <soap:header message="tns:requestheader" part="userId" use="literal"/>
        <soap:header message="tns:requestheader" part="protocolVersion" use="literal"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="populationRegistryService">
    <wsdl:port name="populationRegistryPort" binding="tns:populationRegistryBinding">
      <soap:address location="http://moha-registry:8000/soap"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
